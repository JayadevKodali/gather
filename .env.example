# Gather environment variables. Copy to .env.local and fill in. Never commit real values.
#
# DEMO MODE (default) needs NONE of these. `npm install && npm run dev` just works.
# CONNECTED MODE uses real services and refuses to start if anything below is missing.

# demo | connected
GATHER_MODE=demo

# Public URL of the app, used in email links and Stripe redirects
APP_URL=http://localhost:3000

# Demo mode only: where the embedded Postgres keeps its files (default .data/pglite)
# PGLITE_DIR=.data/pglite

# ---------- connected mode ----------
# Supabase Postgres connection string (Project Settings → Database → Connection string → URI,
# "Transaction pooler" on port 6543 is fine; the app disables prepared statements for it)
DATABASE_URL=
# Password for the seeded reviewer accounts when you run `npm run seed` in connected mode
SEED_PASSWORD=

# Brief reader: OpenAI Responses API with Structured Outputs (server-side only; never sent to the browser).
# Connected mode requires OPENAI_API_KEY unless EXTRACTOR=rules. Demo mode uses the local rules reader
# unless you set EXTRACTOR=openai and a key.
EXTRACTOR=openai
OPENAI_API_KEY=
# Optional. Default gpt-6-luna (economical, supports Structured Outputs).
# OPENAI_MODEL=gpt-6-luna
# Optional. none | low (default) | medium | high
# OPENAI_REASONING_EFFORT=low

# Stripe TEST mode only (keys start sk_test_). Webhook endpoint: <APP_URL>/api/stripe/webhook
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Resend (transactional email)
RESEND_API_KEY=
EMAIL_FROM="Gather <bookings@your-verified-domain.example>"

# Venue photos (Supabase Storage). Server-side only. Create a PRIVATE bucket named venue-photos with no policies.
# Without these on Vercel, uploads say they aren't set up. Locally, photos go to .data/photos.
SUPABASE_URL=
# The project's secret key (sb_secret_…) or legacy service_role key. Never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=
# Optional. Default venue-photos
# SUPABASE_STORAGE_BUCKET=venue-photos
# Optional, local only. Default .data/photos
# PHOTO_DIR=.data/photos

# Daily keep-alive cron (vercel.json → /api/cron/keepalive). Vercel sends it as a bearer token. 32+ random characters.
CRON_SECRET=
